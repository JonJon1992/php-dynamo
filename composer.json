{
    "name": "jonjon1992/php-dynamo",
    "description": "Uma biblioteca PHP moderna e limpa para trabalhar com Amazon DynamoDB, com suporte autom\u00e1tico para ambiente local (LocalStack) e produ\u00e7\u00e3o (AWS)",
    "version": "3.1.0",
    "type": "library",
    "keywords": [
        "dynamodb",
        "aws",
        "localstack",
        "database",
        "nosql",
        "php",
        "orm",
        "repository"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jonathan Braga",
            "email": "jonathan201392127@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Jonjon\\PhpDynamo\\": "lib",
            "Examples\\": "examples"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "require": {
        "php": ">=8.2",
        "aws/aws-sdk-php": "^3.350",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "phpdocumentor/phpdocumentor": "^3.4",
        "roave/security-advisories": "dev-latest"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage --coverage-text",
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "phpstan": "phpstan analyse lib tests",
        "cs": "phpcs lib tests",
        "cs:fix": "phpcbf lib tests",
        "docs": "phpdoc",
        "setup:local": "php scripts/setup-env.php local",
        "setup:production": "php scripts/setup-env.php production",
        "example": "php examples/usage_example_v3.php",
        "test:setup": "php scripts/test-setup.php",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    },
    "support": {
        "issues": "https://github.com/jonjon/php-dynamo/issues",
        "source": "https://github.com/jonjon/php-dynamo",
        "docs": "https://github.com/jonjon/php-dynamo/blob/main/README.md"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
